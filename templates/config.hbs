<div class="dxcfx-root">
  <div class="dxcfx-body">
    <section class="dxcfx-left">
      <div class="dxcfx-preview"></div>
      <p class="hint">{{localize "DXCFX.App.PreviewHint"}}</p>

      <h3>{{localize "DXCFX.App.Area"}}</h3>
      <div class="dxcfx-sliders">
        <label>{{localize "DXCFX.App.AreaName"}}</label>
        <input type="text" name="areaName" value="{{areaName}}" maxlength="60">
        <output></output>
        <label>{{localize "DXCFX.App.Feather"}}</label>
        <input type="range" name="feather" min="0" max="4" step="0.05" value="{{feather}}">
        <output data-for="feather">{{featherText}}</output>
      </div>
      <label class="dxcfx-check">
        <input type="checkbox" name="visible" {{checked visible}}>
        {{localize "DXCFX.App.Visible"}}
      </label>
      <label class="dxcfx-check" data-tooltip="{{localize 'DXCFX.App.ExcludeHint'}}">
        <input type="checkbox" name="exclude" {{checked exclude}}>
        {{localize "DXCFX.App.Exclude"}}
      </label>
      {{#unless exclude}}
      <label class="dxcfx-check" data-tooltip="{{localize 'DXCFX.App.IgnoreExclusionsHint'}}">
        <input type="checkbox" name="ignoreExclusions" {{checked ignoreExclusions}}>
        {{localize "DXCFX.App.IgnoreExclusions"}}
      </label>
      {{/unless}}

      <h3>{{localize "DXCFX.App.SavedEffects"}}</h3>
      <div class="dxcfx-presets">
        <select name="preset">
          <option value="">{{#if presets.length}}{{localize "DXCFX.App.PickSaved"}}{{else}}{{localize "DXCFX.App.NoneSaved"}}{{/if}}</option>
          {{#if presets.length}}<optgroup label="{{localize 'DXCFX.App.YourEffects'}}">
          {{#each presets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </optgroup>{{/if}}
          <optgroup label="{{localize 'DXCFX.App.Examples'}}">
          {{#each examples}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </optgroup>
        </select>
        <button type="button" data-action="loadPreset" {{#unless hasPreset}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.LoadHint'}}"><i class="fa-solid fa-folder-open"></i></button>
        <button type="button" data-action="savePreset" data-tooltip="{{localize 'DXCFX.App.SaveHint'}}"><i class="fa-solid fa-floppy-disk"></i></button>
        <button type="button" data-action="deletePreset" {{#unless canDeletePreset}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.DeleteHint'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      <p class="hint">{{localize "DXCFX.App.SavedHint"}}</p>
      <div class="dxcfx-transfer">
        <button type="button" data-action="exportEffect" data-tooltip="{{localize 'DXCFX.Transfer.ExportHint'}}"><i class="fa-solid fa-file-export"></i> {{localize "DXCFX.Transfer.Export"}}</button>
        <button type="button" data-action="importEffect" data-tooltip="{{localize 'DXCFX.Transfer.ImportHint'}}"><i class="fa-solid fa-file-import"></i> {{localize "DXCFX.Transfer.Import"}}</button>
        <input type="file" name="effectFile" accept=".json,application/json" hidden>
      </div>
    </section>

    <section class="dxcfx-right">
      {{#if exclude}}
      <div class="dxcfx-exclusion compact">
        <i class="fa-solid fa-ban"></i>
        <p>{{localize "DXCFX.App.ExclusionText"}}</p>
      </div>
      {{/if}}
      {{#if hasLayer}}
      <h3>{{localize "DXCFX.App.Layers"}} <small>{{localize "DXCFX.App.LayersHint"}}</small></h3>
      <div class="dxcfx-layers">
        {{#each layers}}
        <button type="button" data-action="selectLayer" data-index="{{index}}" class="{{#if active}}active{{/if}}" data-tooltip="{{label}}">
          {{#if thumb}}<img src="{{thumb}}" alt="">{{else}}<i class="{{icon}}"></i>{{/if}}<span>{{label}}</span>
        </button>
        {{/each}}
        <button type="button" class="dxcfx-add" data-action="addLayer" {{#unless canAddLayer}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.AddLayerHint'}}"><i class="fa-solid fa-plus"></i> {{localize "DXCFX.App.AddLayer"}}</button>
      </div>
      <div class="dxcfx-layer-tools">
        <span>{{localize "DXCFX.App.Editing" n=layerNumber of=layerCount}}</span>
        <button type="button" data-action="moveLayer" data-dir="-1" {{#unless canMoveDown}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.MoveDown'}}"><i class="fa-solid fa-arrow-left"></i></button>
        <button type="button" data-action="moveLayer" data-dir="1" {{#unless canMoveUp}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.MoveUp'}}"><i class="fa-solid fa-arrow-right"></i></button>
        <button type="button" data-action="duplicateLayer" {{#unless canAddLayer}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.Duplicate'}}"><i class="fa-solid fa-clone"></i></button>
        <button type="button" data-action="removeLayer" {{#unless canRemoveLayer}}disabled{{/unless}} data-tooltip="{{localize 'DXCFX.App.RemoveLayer'}}"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <h3>{{localize "DXCFX.App.Effect"}}</h3>
      {{#each effectGroups}}
      <div class="dxcfx-group-label">{{localize label}}</div>
      <div class="dxcfx-effects">
        {{#each effects}}
        <button type="button" data-action="effect" data-effect="{{id}}" class="{{#if active}}active{{/if}} {{#if custom}}custom{{/if}}" data-tooltip="{{label}}">
          <i class="{{icon}}"></i><span>{{label}}</span>
        </button>
        {{/each}}
      </div>
      {{/each}}
      {{#if needsMap}}<p class="hint dxcfx-left-hint">{{localize "DXCFX.App.NeedsMap"}}</p>{{/if}}

      <h3>{{localize "DXCFX.App.Style"}} <small>{{effectLabel}}</small></h3>
      <div class="dxcfx-styles">
        {{#each styles}}
        <button type="button" data-action="style" data-style="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
        {{/each}}
      </div>

      {{#if isImage}}
      <h3>{{localize "DXCFX.App.Image"}}</h3>
      <div class="dxcfx-image">
        <div class="dxcfx-thumb">{{#if src}}<img src="{{src}}" alt="">{{else}}<i class="fa-solid fa-image"></i>{{/if}}</div>
        <div class="dxcfx-image-src">
          <input type="text" name="src" value="{{src}}" placeholder="{{localize 'DXCFX.App.ImagePath'}}">
          <div class="dxcfx-image-buttons">
            <button type="button" data-action="browseImage" {{#unless canBrowse}}disabled{{/unless}}><i class="fa-solid fa-folder-open"></i> {{localize "DXCFX.App.Browse"}}</button>
            <button type="button" data-action="uploadImage" {{#unless canUpload}}disabled{{/unless}}><i class="fa-solid fa-upload"></i> {{localize "DXCFX.App.Upload"}}</button>
            <input type="file" name="imageFile" accept="image/png,image/webp,image/*" hidden>
          </div>
        </div>
      </div>
      <div class="dxcfx-sliders">
        <label>{{localize "DXCFX.App.Fit"}}</label>
        <select name="fit">{{#each fits}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
        <output></output>
      </div>
      {{/if}}

      <h3>{{localize "DXCFX.App.Tune"}}</h3>
      <div class="dxcfx-sliders">
        {{#each sliders}}
        <label>{{localize label}}</label>
        <input type="range" data-param name="{{name}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}" data-fmt="{{fmt}}">
        <output data-for="{{name}}">{{text}}</output>
        {{/each}}
        <label>{{localize "DXCFX.App.Color"}}</label>
        <span class="dxcfx-color">
          <input type="checkbox" name="useColor" {{checked useColor}} data-tooltip="{{localize 'DXCFX.App.ColorHint'}}">
          <input type="color" name="color" value="{{color}}" {{#unless useColor}}disabled{{/unless}}>
        </span>
        <output></output>
        <label>{{localize "DXCFX.App.Blend"}}</label>
        <select name="blend">{{#each blends}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
        <output></output>
      </div>

      {{#if hasSound}}
      <h3>{{localize "DXCFX.App.Sound"}}</h3>
      <div class="dxcfx-sound">
        <input type="text" name="sound" value="{{sound}}" placeholder="{{localize 'DXCFX.App.SoundPath'}}">
        <button type="button" data-action="browseSound" data-tooltip="{{localize 'DXCFX.App.Browse'}}"><i class="fa-solid fa-music"></i></button>
      </div>
      <p class="hint dxcfx-left-hint">{{localize "DXCFX.App.SoundHint"}}</p>
      {{/if}}

      {{#if hasLight}}
      <label class="dxcfx-check" data-tooltip="{{localize 'DXCFX.App.LightHint'}}">
        <input type="checkbox" name="light" {{checked light}}>
        {{localize "DXCFX.App.Light"}}
      </label>
      {{/if}}

      {{#if canAboveTokens}}
      <label class="dxcfx-check" data-tooltip="{{localize 'DXCFX.App.AboveTokensHint'}}">
        <input type="checkbox" name="aboveTokens" {{checked aboveTokens}}>
        {{localize "DXCFX.App.AboveTokens"}}
      </label>
      {{/if}}

      <h3>{{localize "DXCFX.App.Effects"}}</h3>
      <div class="dxcfx-sliders">
        {{#each common}}
        <label>{{localize label}}</label>
        <input type="range" data-param name="{{name}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}" data-fmt="{{fmt}}">
        <output data-for="{{name}}">{{text}}</output>
        {{/each}}
      </div>
      {{else}}
      <div class="dxcfx-empty">
        <p>{{localize "DXCFX.App.NoLayersText"}}</p>
        <button type="button" data-action="addLayer"><i class="fa-solid fa-plus"></i> {{localize "DXCFX.App.AddInside"}}</button>
      </div>
      {{/if}}
    </section>
  </div>

  <footer class="form-footer dxcfx-footer">
    <span class="dxcfx-dirty {{#if dirty}}on{{/if}}" data-tooltip="{{localize 'DXCFX.App.DirtyHint'}}"><i class="fa-solid fa-circle"></i> {{localize "DXCFX.App.Dirty"}}</span>
    <button type="button" data-action="resetLayer" data-tooltip="{{localize 'DXCFX.App.ResetHint'}}"><i class="fa-solid fa-rotate-left"></i> {{localize "DXCFX.App.Reset"}}</button>
    <button type="button" data-action="revert" data-tooltip="{{localize 'DXCFX.App.RevertHint'}}"><i class="fa-solid fa-clock-rotate-left"></i> {{localize "DXCFX.App.Revert"}}</button>
    <button type="button" data-action="clearEffect" data-tooltip="{{localize 'DXCFX.App.ClearHint'}}"><i class="fa-solid fa-ban"></i> {{localize "DXCFX.App.Clear"}}</button>
    <button type="button" data-action="apply" class="bright"><i class="fa-solid fa-check"></i> {{localize "DXCFX.App.Apply"}}</button>
  </footer>
</div>
